@using SecondHandMarket.Web.ViewModels.Admin
@model SalesmanViewModel

<tr id="@Model.Phone" style="height:40px;">
    <td><a href="#" onclick="showPrintOutForm('@Model.Phone')">@Model.FullName</a></td>
    <td>@Model.Phone</td>
    <td>@Model.Member</td>
    <td>@Model.NumberOfRegiteredItems</td>
    <td>@Model.NumberOfSoldItems</td>
    <td>@Model.NumberOfPaidOutItems</td>
    <td>@Model.AmoutToPayOut kr</td>
    <td>@Model.Bank</td>
    <td>
        @if (!String.IsNullOrWhiteSpace(Model.BankAccount))
        {
            @Model.BankAccount
            <button type="button" class="btn btn-xs btn-default" title="Kopiera kontonummer" data-copy="@Model.BankAccount" onclick="copyToClipboard(this, $(this).attr('data-copy'))">
                <span class="glyphicon glyphicon-copy" aria-hidden="true"></span><span class="sr-only">Kopiera kontonummer</span>
            </button>
        }
    </td>
    <td>
        @if (Model.AmoutToPayOut > 0)
        {
            <button type="button" class="btn btn-sm btn-primary pull-right" onclick="showPayOutForm('@Model.Phone')">
                UTBETALNING
            </button>
        }

    </td>
</tr>